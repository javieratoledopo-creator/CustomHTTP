# ---- CUSTOM HTTP :: variables de entorno ----
# Copiar como .env y completar. NUNCA subir .env al repositorio.

NODE_ENV=production
PORT=8080

# URL publica del backend (usada por el panel y la app Android)
API_URL=https://api.midominio.com
# URL/dominio principal del servicio
SERVER_URL=https://midominio.com

# PostgreSQL
DATABASE_URL=postgres://customhttp:CAMBIAR@localhost:5432/customhttp
POSTGRES_USER=customhttp
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=customhttp

# Secretos (generar con: openssl rand -hex 48)
JWT_SECRET=CAMBIAR_openssl_rand_hex_48
CONFIG_SIGNING_SECRET=CAMBIAR_openssl_rand_hex_48

# Administrador inicial
ADMIN_EMAIL=admin@midominio.com
ADMIN_PASSWORD=CAMBIAR

# Sesiones y configuraciones
SESSION_TTL_MINUTES=720
CONFIG_TTL_HOURS=168
MAX_SESSIONS_DEFAULT=1

# CORS: origenes permitidos del panel (separados por coma)
CORS_ORIGINS=https://panel.midominio.com,http://localhost:5173

# HTTPS (si se termina TLS en Node en vez de Nginx)
TLS_CERT_PATH=
TLS_KEY_PATH=
