<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS/TLS. No se permite trafico en claro. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
